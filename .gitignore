# individual users should follow build steps in README -- creating this folder themselves
build/

# datasets over 100.0MB cannot be tracked by GitHub
# consider Git LFS or script to download untracked datasets
# still want to track empty test folder though
#test/*
!test/.gitkeep
!test/2_10.dat
!test/2_11.dat
!test/2_12.dat
!test/2_13.dat
!test/2_14.dat
test/test_*.dat

# Python bytecode
__pycache__/
*.pyc

# misc untracked files
.vscode/
*.txt

benchmark_results/
!benchmark_results/aggregate_benchmarks.py
benchmark_*.csv

# Ignore all runtime/benchmark logs and csv artifacts
*.log
*.csv

# Serialized crypto data (generated at runtime)
serial/

# Generated datasets
data/

# Runtime output
latency.csv
Note_on_benchmarks

venv

# Internal reports and paper drafts
quick-reports/
overleaf-project/

# Docker H200 (local-only)
Dockerfile.h200
.dockerignore